{
  "name": "aff-link-converter",
  "version": "1.0.0",
  "description": "Web App chuyển đổi link Affiliate Shopee & TikTok Shop tự động (Bulk Convert)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/run_all_tests.js",
    "test:postgres": "node tests/postgres.integration.js",
    "test:rotation": "node tests/settings-rotation.integration.js",
    "lint": "eslint .",
    "check:config": "node scripts/production-preflight.js",
    "check:production": "node scripts/production-smoke.js",
    "test:regression": "node tests/final-audit-diagnostics.js",
    "test:browser": "node tests/withdrawal-ui.e2e.js",
    "test:csv:postgres": "node tests/csv-postgres.integration.js",
    "test:csv:browser": "node tests/csv-import.e2e.js",
    "test:capacity": "node tests/load.capacity.js",
    "test:compare-accuracy": "node tests/compare/benchmark_compare.js --strict"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1"
  }
}
